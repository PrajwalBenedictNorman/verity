# PostgreSQL database connection URL (with pgvector extension)
DATABASE_URL=postgres://verity:verity@127.0.0.1:5432/verity

# Secret used to encrypt NextAuth session tokens (generate with `openssl rand -base64 32`)
NEXTAUTH_SECRET=

# Public canonical URL of the application
NEXTAUTH_URL=http://localhost:3000

# Password for demo seeded users (creator@kettle.test, reviewer@kettle.test, admin@kettle.test)
SEED_USER_PASSWORD=

# Local storage path for uploaded documents and images
STORAGE_DIR=./storage

# Toggle AI deep review tier (set to false to run fast rule-based tier only with zero external calls)
AI_ENABLED=true

# OpenAI-compatible API base URL (e.g. OpenAI or Gemini /v1beta/openai)
AI_BASE_URL=

# Provider API key (never commit or log this key)
AI_API_KEY=

# Chat model name for deep claim and tone verification (lookup available models via GET {AI_BASE_URL}/models)
AI_MODEL=

# Optional fallback chat model if the primary model is unavailable
AI_FALLBACK_MODEL=

# Embedding model name for vector semantic retrieval
EMBEDDING_MODEL=

# Dimensionality of the vector embeddings matching pgvector schema (default: 1536)
EMBEDDING_DIM=1536

# Minimum cosine similarity threshold for vector retrieval (0.0 to 1.0, default: 0.30)
RETRIEVAL_MIN_SIM=0.30

# Request timeout in milliseconds for individual AI provider calls (default: 30000)
AI_TIMEOUT_MS=30000

# Maximum retry attempts for transient errors (default: 2)
AI_MAX_RETRIES=2

# Maximum concurrent AI requests in flight (default: 2; recommend 1 for free-tier quotas)
AI_MAX_CONCURRENCY=2

# Requests per minute rate limit bucket (default: 10; recommend 5 for free-tier quotas; 0 disables)
AI_RPM_LIMIT=10

# Circuit breaker cooldown in milliseconds after quota/auth failure before allowing a probe (default: 300000)
AI_BREAKER_COOLDOWN_MS=300000

# Number of claim candidates to evaluate per batched chat completion request (default: 6)
AI_CLAIM_BATCH_SIZE=6

# Character budget per document chunk for tone analysis (default: 6000)
AI_TONE_CHUNK_CHARS=6000

# Number of texts to embed in a single embeddings batch request (default: 32)
EMBED_BATCH_SIZE=32

# Overall time budget in milliseconds for deep tier execution per review before timing out (default: 120000)
AI_DEEP_BUDGET_MS=120000

# Maximum age in milliseconds for a running/pending review before watchdog marks it interrupted (default: 300000)
AI_DEEP_STALE_MS=300000

# Days to retain cached AI verdicts if response caching is enabled (default: 7)
AI_CACHE_TTL_DAYS=7

# Enable multi-modal vision inspection for image assets in submissions (default: false)
ENABLE_VISION=false

# Review tier executed after applying a finding fix: "full" (runs deep tier if AI enabled) or "fast" (default: full)
REVIEW_AFTER_APPLY=full
